#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require

// Prepass test: loads this draw's 8-dword scratch record through a physical storage buffer pointer
// keyed by DrawIndex (what the mesh_record variant does) and copies it out. Slot 8 * draws + draw
// counts the launched workgroups.
layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Records { uint words[]; };
layout(std430, set = 0, binding = 0) buffer Out { uint value[]; } out_buffer;
layout(push_constant) uniform Push { Records records; uint draws; } pc;

void main() {
	SetMeshOutputsEXT(0, 0);
	const uint draw = uint(gl_DrawID);
	atomicAdd(out_buffer.value[8u * pc.draws + draw], 1u);
	if (gl_WorkGroupID == uvec3(0)) {
		for (uint k = 0u; k < 8u; k++) {
			out_buffer.value[draw * 8u + k] = pc.records.words[draw * 8u + k];
		}
	}
}
