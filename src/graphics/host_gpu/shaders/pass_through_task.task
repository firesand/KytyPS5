#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : enable
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// GPU-side indirect mesh draws (KYTY_CP_GPU_INDIRECT): one task workgroup per non-indexed
// DrawIndirectArgs record; launches the record's mesh groups and forwards the record in the payload
// (the recompiled mesh program reads it, EmitMeshDrawParameter / EmitGetUserData).

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// Device mesh workgroup limits (meshTaskIndirect.h kTaskSpec*).
layout(constant_id = 0) const uint MAX_GROUPS_X = 65535u;
layout(constant_id = 1) const uint MAX_GROUPS_Y = 65535u;
layout(constant_id = 2) const uint MAX_GROUPS_TOTAL = 65535u;

layout(buffer_reference, scalar) readonly buffer DrawIndirectArgsBuffer {
	uint vertex_count;
	uint instance_count;
	uint first_vertex;
	uint first_instance;
};

// meshTaskIndirect.h MeshTaskCounters.
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer TaskCounters {
	uint clamped_records;
	uint empty_records;
};

// Field order is fixed by the mesh side (spirvEmitterModule.cpp DefineInputs).
struct TaskPayload {
	uint vertex_count;
	uint first_vertex;
	uint first_instance;
	uint draw_id;
};

taskPayloadSharedEXT TaskPayload payload;

// meshTaskIndirect.h MeshTaskPushConstants: at most 24 bytes, the mesh program's shader-data window
// starts at push dword 6.
layout(push_constant) uniform PushConstants {
	uint64_t args_bda;
	uint stride;
	uint primitive_info; // primitives_per_group | size << 16 | step << 24
	uint64_t counters_bda; // 0: probe off
} pc;

void main() {
	uint draw_id = gl_WorkGroupID.x;
	uint64_t record_addr = pc.args_bda + uint64_t(draw_id) * uint64_t(pc.stride);

	DrawIndirectArgsBuffer args = DrawIndirectArgsBuffer(record_addr);
	uint vertex_count = args.vertex_count;
	uint instance_count = args.instance_count;
	uint first_vertex = args.first_vertex;
	uint first_instance = args.first_instance;

	// Host formula (ShaderMeshInputInfo::InputPrimitiveCount, ExecutePreparedDraw): primitives from
	// the vertex count by input primitive size / step, then ceil(primitives / primitives_per_group).
	uint ppg = max(pc.primitive_info & 0xffffu, 1u);
	uint size = max((pc.primitive_info >> 16u) & 0xffu, 1u);
	uint step = max(pc.primitive_info >> 24u, 1u);
	uint primitives = vertex_count < size ? 0u : (vertex_count - size) / step + 1u;

	if (primitives == 0u || instance_count == 0u) {
		if (pc.counters_bda != 0ul) {
			atomicAdd(TaskCounters(pc.counters_bda).empty_records, 1u);
		}
		EmitMeshTasksEXT(0u, 0u, 0u);
		return;
	}

	uint groups_x = (primitives - 1u) / ppg + 1u;
	uint groups_y = instance_count;
	// The host path EXITs past a device limit; here the record is clamped (and counted).
	bool clamped = false;
	if (groups_x > MAX_GROUPS_X) {
		groups_x = MAX_GROUPS_X;
		clamped = true;
	}
	if (groups_y > MAX_GROUPS_Y) {
		groups_y = MAX_GROUPS_Y;
		clamped = true;
	}
	if (uint64_t(groups_x) * uint64_t(groups_y) > uint64_t(MAX_GROUPS_TOTAL)) {
		groups_x = min(groups_x, MAX_GROUPS_TOTAL);
		groups_y = max(MAX_GROUPS_TOTAL / groups_x, 1u);
		clamped = true;
	}
	if (clamped && pc.counters_bda != 0ul) {
		atomicAdd(TaskCounters(pc.counters_bda).clamped_records, 1u);
	}

	payload.vertex_count = vertex_count;
	payload.first_vertex = first_vertex;
	payload.first_instance = first_instance;
	payload.draw_id = draw_id;

	EmitMeshTasksEXT(groups_x, groups_y, 1u);
}
